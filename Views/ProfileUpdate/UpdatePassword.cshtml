@{
    ViewData["Title"] = "Update Password";
    Layout = "../Shared/_EmployeeLayout.cshtml";
}

<style>
    :root {
        --primary-color: #ff9500;
        --primary-gradient: linear-gradient(135deg, #ff9500 0%, #ff6b35 100%);
        --secondary-color: #6c757d;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --light-color: #f8f9fa;
        --dark-color: #343a40;
        --border-radius: 16px;
        --box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        --transition: all 0.3s ease;
    }

    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ed 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
    }

    .password-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .password-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        padding: 40px 35px 35px;
        width: 100%;
        max-width: 450px;
        position: relative;
        transition: var(--transition);
        border: none;
    }

    .password-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }

    .close-btn {
        position: absolute;
        top: 15px;
        right: 20px;
        background: none;
        border: none;
        font-size: 24px;
        color: var(--secondary-color);
        cursor: pointer;
        transition: var(--transition);
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .close-btn:hover {
        background: #f8f9fa;
        color: var(--dark-color);
        transform: scale(1.1);
    }

    .card-header {
        text-align: center;
        margin-bottom: 35px;
    }

    .card-title {
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--dark-color);
        margin: 0 0 10px 0;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .card-subtitle {
        color: var(--secondary-color);
        font-size: 0.95rem;
        margin: 0;
    }

    .form-group {
        margin-bottom: 25px;
        position: relative;
    }

    .form-label {
        display: block;
        font-weight: 500;
        color: var(--dark-color);
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-label i {
        color: var(--primary-color);
        width: 16px;
    }

    .password-input {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 1rem;
        transition: var(--transition);
        background: white;
    }

    .password-input:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(255, 149, 0, 0.1);
        outline: none;
    }

    .password-input.k-state-focused {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(255, 149, 0, 0.1);
    }

    .error-message {
        color: var(--danger-color);
        font-size: 0.85rem;
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .error-message i {
        font-size: 0.8rem;
    }

    .submit-btn {
        width: 100%;
        padding: 15px;
        background: var(--primary-gradient);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 7px 15px rgba(255, 149, 0, 0.4);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .password-strength {
        margin-top: 8px;
        font-size: 0.85rem;
    }

    .strength-weak {
        color: var(--danger-color);
    }

    .strength-medium {
        color: #ff9800;
    }

    .strength-strong {
        color: var(--success-color);
    }

    .password-requirements {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-top: 20px;
        border-left: 4px solid var(--primary-color);
    }

    .requirements-title {
        font-weight: 600;
        color: var(--dark-color);
        margin-bottom: 8px;
        font-size: 0.9rem;
    }

    .requirements-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.85rem;
        color: var(--secondary-color);
    }

    .requirements-list li {
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .requirements-list li i {
        font-size: 0.7rem;
        color: var(--success-color);
    }

    /* Kendo Overrides */
    .k-textbox {
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 12px 16px;
        transition: var(--transition);
    }

    .k-textbox:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(255, 149, 0, 0.1);
    }

    .k-button {
        border-radius: 10px;
        font-weight: 500;
        transition: var(--transition);
    }

    /* Responsive Design */
    @@media (max-width: 576px) {
        .password-card {
            padding: 30px 25px 25px;
            margin: 10px;
        }

        .card-title {
            font-size: 1.6rem;
        }
    }

    /* Loading State */
    .submit-btn.loading {
        pointer-events: none;
        opacity: 0.8;
    }

    .submit-btn.loading i {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<div class="password-container">
    <div class="password-card">
        <!-- Close Button -->
        <button id="closeCard" class="close-btn" title="Close">
            <i class="fas fa-times"></i>
        </button>

        <!-- Card Header -->
        <div class="card-header">
            <h2 class="card-title">Update Password</h2>
            <p class="card-subtitle">Secure your account with a new password</p>
        </div>

        <!-- Password Form -->
        <form id="passwordForm">
            <!-- Old Password -->
            <div class="form-group">
                <label for="oldPassword" class="form-label">
                    <i class="fas fa-lock"></i> Old Password
                </label>
                <input type="password" id="oldPassword" name="oldPassword" class="password-input" />
                <span id="errOldPassword" class="error-message"></span>
            </div>

            <!-- New Password -->
            <div class="form-group">
                <label for="newPassword" class="form-label">
                    <i class="fas fa-key"></i> New Password
                </label>
                <input type="password" id="newPassword" name="newPassword" class="password-input" />
                <span id="errNewPassword" class="error-message"></span>
                <div id="passwordStrength" class="password-strength"></div>
            </div>

            <!-- Confirm Password -->
            <div class="form-group">
                <label for="confirmPassword" class="form-label">
                    <i class="fas fa-check-double"></i> Confirm Password
                </label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="password-input" />
                <span id="errConfirmPassword" class="error-message"></span>
            </div>

            <!-- Password Requirements -->
            <div class="password-requirements">
                <div class="requirements-title">Password Requirements:</div>
                <ul class="requirements-list">
                    <li><i class="fas fa-check"></i> At least 6 characters long</li>
                    <li><i class="fas fa-check"></i> Should not match old password</li>
                    <li><i class="fas fa-check"></i> Use a combination of letters and numbers</li>
                </ul>
            </div>

            <!-- Submit Button -->
            <button type="button" id="btnUpdatePassword" class="submit-btn">
                <i class="fas fa-shield-alt"></i> Update Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // Close button functionality
            $("#closeCard").click(function () {
                window.location.href = '/Profile/Index';
            });

            // Initialize Kendo TextBoxes for passwords
            $("#oldPassword").kendoTextBox({ 
                placeholder: "Enter your current password",
                change: function() {
                    $("#errOldPassword").text("");
                }
            });

            $("#newPassword").kendoTextBox({ 
                placeholder: "Enter your new password",
                change: function() {
                    validateNewPassword();
                }
            });

            $("#confirmPassword").kendoTextBox({ 
                placeholder: "Confirm your new password",
                change: function() {
                    validateConfirmPassword();
                }
            });

            // Initialize Kendo Button
            $("#btnUpdatePassword").kendoButton();

            // Password strength indicator
            function validateNewPassword() {
                const newPass = $("#newPassword").val();
                const strength = $("#passwordStrength");
                const errNew = $("#errNewPassword");

                if (!newPass) {
                    strength.text("");
                    errNew.text("");
                    return;
                }

                if (newPass.length < 6) {
                    strength.text("Password strength: Weak").addClass("strength-weak").removeClass("strength-medium strength-strong");
                    errNew.text("Password must be at least 6 characters");
                } else if (newPass.length < 8) {
                    strength.text("Password strength: Medium").addClass("strength-medium").removeClass("strength-weak strength-strong");
                    errNew.text("");
                } else {
                    strength.text("Password strength: Strong").addClass("strength-strong").removeClass("strength-weak strength-medium");
                    errNew.text("");
                }
            }

            function validateConfirmPassword() {
                const newPass = $("#newPassword").val();
                const confirmPass = $("#confirmPassword").val();
                const errConfirm = $("#errConfirmPassword");

                if (!confirmPass) {
                    errConfirm.text("");
                    return;
                }

                if (newPass !== confirmPass) {
                    errConfirm.text("Passwords do not match");
                } else {
                    errConfirm.text("");
                }
            }

            // AJAX submit with SweetAlert2
            $("#btnUpdatePassword").click(function () {
                var oldPass = $("#oldPassword").val();
                var newPass = $("#newPassword").val();
                var confirmPass = $("#confirmPassword").val();
                var isValid = true;

                // Validation
                if (!oldPass) {
                    $("#errOldPassword").text("Old password is required");
                    isValid = false;
                } else {
                    $("#errOldPassword").text("");
                }

                if (!newPass) {
                    $("#errNewPassword").text("New password is required");
                    isValid = false;
                } else if (newPass.length < 6) {
                    $("#errNewPassword").text("Password must be at least 6 characters");
                    isValid = false;
                } else {
                    $("#errNewPassword").text("");
                }

                if (!confirmPass) {
                    $("#errConfirmPassword").text("Confirm password is required");
                    isValid = false;
                } else if (newPass !== confirmPass) {
                    $("#errConfirmPassword").text("Passwords do not match");
                    isValid = false;
                } else {
                    $("#errConfirmPassword").text("");
                }

                if (!isValid) return;

                // Show loading state
                const btn = $(this);
                btn.addClass('loading').html('<i class="fas fa-spinner fa-spin"></i> Updating...');

                // AJAX call
                $.ajax({
                    url: '/ProfileUpdate/UpdatePassword',
                    type: 'POST',
                    data: { oldPassword: oldPass, newPassword: newPass },
                    success: function (response) {
                        Swal.fire({
                            icon: response.success ? 'success' : 'error',
                            title: response.success ? 'Password Updated!' : 'Update Failed',
                            text: response.message,
                            confirmButtonColor: response.success ? '#ff9500' : '#d33',
                            confirmButtonText: 'OK'
                        }).then((result) => {
                            if (response.success && result.isConfirmed) {
                                window.location.href = '/Profile/Index';
                            }
                        });

                        if (response.success) {
                            $("#passwordForm")[0].reset();
                            $("#passwordStrength").text("");
                        }
                    },
                    error: function (err) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Server Error!',
                            text: 'Something went wrong while updating password. Please try again.',
                            confirmButtonColor: '#d33'
                        });
                        console.error(err);
                    },
                    complete: function () {
                        // Reset button state
                        btn.removeClass('loading').html('<i class="fas fa-shield-alt"></i> Update Password');
                    }
                });
            });

            // Enter key support
            $("#passwordForm input").keypress(function (e) {
                if (e.which === 13) {
                    $("#btnUpdatePassword").click();
                }
            });
        });
    </script>
}