@{
    ViewData["Title"] = "Attendance Summary";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --primary-orange: #ff9500;
        --dark-orange: #e08600;
        --light-orange: #fff3e0;
        --card-orange: #fffaf0;
    }

    /* Page Title */
    .page-title {
        color: var(--primary-orange);
        font-weight: 700;
        text-shadow: 2px 2px 4px rgba(255, 149, 0, 0.1);
        margin-bottom: 30px;
    }

    /* Filter Section */
    .filter-container {
        background: linear-gradient(135deg, #fffaf0 0%, #fff3e0 100%);
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #ffd8b1;
        margin-bottom: 25px;
    }

    .filter-label {
        color: var(--dark-orange);
        font-weight: 600;
        font-size: 1.1rem;
    }

    /* Custom Buttons */
    .btn-custom-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        border: none;
        color: white;
        border-radius: 8px;
        padding: 8px 20px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-custom-secondary:hover {
        background: linear-gradient(135deg, #5a6268 0%, #495057 100%);
        color: white;
        transform: translateY(-2px);
    }

    .btn-custom-pdf {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        border: none;
        color: white;
        border-radius: 8px;
        padding: 8px 20px;
        font-weight: 500;
        transition: all 0.3s ease;
        margin-left: 10px;
    }

    .btn-custom-pdf:hover {
        background: linear-gradient(135deg, #c82333 0%, #bd2130 100%);
        color: white;
        transform: translateY(-2px);
    }

    /* Grid Container */
    .grid-container {
        background: white;
        border-radius: 12px;
        padding: 0;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #ffd8b1;
        overflow: hidden;
        position: relative;
    }

    /* Custom Status Badges */
    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
        text-align: center;
        display: inline-block;
    }

    .status-present {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .status-late {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        color: #856404;
        border: 1px solid #ffeaa7;
    }

    .status-early {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    /* Kendo Grid Customization */
    .k-grid-header {
        background: linear-gradient(135deg, #ff9500 0%, #ff6b35 100%) !important;
        color: white !important;
    }

    .k-grid-header .k-header {
        background: transparent !important;
        color: white !important;
        font-weight: 600;
        border-right: 1px solid rgba(255, 255, 255, 0.2);
    }

    .k-grid-header .k-header>.k-link {
        color: white !important;
    }

    .k-grid-content {
        border-color: #ffd8b1;
    }

    .k-grid tr {
        transition: background-color 0.3s ease;
    }

    @* .k-grid tr:hover {
        background-color: #fffaf0 !important;
    } *@

    .k-grid tr.k-alt {
        background-color: #fffaf0;
    }

    .k-grid td {
        border-color: #ffd8b1;
        padding: 12px 8px;
    }

    /* Toolbar Styling */
    .k-grid-toolbar {
        background: linear-gradient(135deg, #fffaf0 0%, #fff3e0 100%) !important;
        border-bottom: 1px solid #ffd8b1;
        padding: 12px 15px;
    }

    .k-grid-toolbar .k-button {
        border-radius: 6px;
        font-weight: 500;
    }

    .k-grid-toolbar .k-button.k-button-primary {
        background: linear-gradient(135deg, #ff9500 0%, #e08600 100%);
        border: none;
        color: white;
    }

    .k-grid-toolbar .k-button.k-button-primary:hover {
        background: linear-gradient(135deg, #e08600 0%, #cc7700 100%);
    }

    /* Pagination Styling */
    .k-pager-wrap {
        background: linear-gradient(135deg, #fffaf0 0%, #fff3e0 100%) !important;
        border-top: 1px solid #ffd8b1;
        color: var(--dark-orange);
    }

    .k-pager-numbers .k-state-selected {
        background: linear-gradient(135deg, #ff9500 0%, #e08600 100%) !important;
        border-color: var(--primary-orange);
        color: white;
    }

    .k-pager-numbers .k-link {
        color: var(--dark-orange);
    }

    /* Search Box Styling */
    .k-textbox {
        border-radius: 6px;
        border: 1px solid #ffd8b1;
    }

    .k-textbox:focus {
        border-color: var(--primary-orange);
        box-shadow: 0 0 0 3px rgba(255, 149, 0, 0.2);
    }

    /* Date Picker Customization */
    .k-datepicker {
        border-radius: 8px;
        border: 1px solid #ffd8b1;
    }

    .k-datepicker:focus {
        border-color: var(--primary-orange);
        box-shadow: 0 0 0 3px rgba(255, 149, 0, 0.2);
    }

    /* Export Button Container */
    .export-container {
        margin-bottom: 15px;
        text-align: right;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .filter-container .row {
            text-align: center;
        }

        .filter-container .col-auto {
            margin-bottom: 10px;
        }

        .btn-custom-secondary,
        .btn-custom-pdf {
            width: 100%;
            margin-left: 0;
            margin-top: 10px;
        }

        .export-container {
            text-align: center;
        }
    }

    /* Loading Animation */
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 250, 240, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        border-radius: 12px;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #ffd8b1;
        border-top: 4px solid var(--primary-orange);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

<div class="container mt-4">
    <h3 class="text-center mb-4 page-title">Attendance Summary</h3>

    <!-- 🔹 Filter Section -->
    <div class="filter-container">
        <div class="row align-items-center justify-content-center">
            <div class="col-auto">
                <label class="filter-label me-2">Select Date:</label>
            </div>
            <div class="col-auto">
                <input id="dateFilter" style="width: 250px;" />
            </div>
            <div class="col-auto">
                <button id="clearFilter" class="btn btn-custom-secondary">
                    <i class="k-icon k-i-reset"></i> Clear Filter
                </button>
            </div>
        </div>
    </div>

    <!-- 🔹 Export Button -->
    <div class="export-container">
        <button id="exportAllPdf" class="btn btn-custom-pdf">
            <i class="k-icon k-i-file-pdf"></i> Export All to PDF
        </button>
        <span class="ms-3 filter-label">CSV from</span>
        <input id="csvFrom" style="width: 160px;" />
        <span class="filter-label">to</span>
        <input id="csvTo" style="width: 160px;" />
        <button id="exportCsv" class="btn btn-custom-secondary">
            <i class="k-icon k-i-file-csv"></i> Export CSV
        </button>
    </div>

    <!-- 🔹 Grid Container -->
    <div class="grid-container">
        <div id="attendanceGrid"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#dateFilter").kendoDatePicker({
                format: "dd-MMM-yyyy",
                change: function () {
                    loadGrid();
                }
            }).data("kendoDatePicker").wrapper.css({
                'border-radius': '8px',
                'border': '1px solid #ffd8b1'
            });

            $("#clearFilter").click(function () {
                $("#dateFilter").data("kendoDatePicker").value("");
                loadGrid();
            });

            $("#exportAllPdf").click(function () {
                exportAllToPdf();
            });

            var today = new Date();
            var monthAgo = new Date(); monthAgo.setDate(today.getDate() - 29);
            $("#csvFrom").kendoDatePicker({ format: "dd-MMM-yyyy", value: monthAgo });
            $("#csvTo").kendoDatePicker({ format: "dd-MMM-yyyy", value: today });

            $("#exportCsv").click(function () {
                var from = $("#csvFrom").data("kendoDatePicker").value();
                var to = $("#csvTo").data("kendoDatePicker").value();
                if (!from || !to) { kendo.alert("Please choose both dates."); return; }
                if (from > to) { kendo.alert("'From' must be before 'To'."); return; }
                var url = "/Admin/ExportAttendanceCsv?from=" + kendo.toString(from, "yyyy-MM-dd") +
                          "&to=" + kendo.toString(to, "yyyy-MM-dd");
                window.location.href = url;
            });

            function loadGrid() {
                var selectedDate = $("#dateFilter").data("kendoDatePicker").value();

                // Show loading
                $(".grid-container").append(
                    '<div class="loading-overlay"><div class="spinner"></div></div>'
                );

                $("#attendanceGrid").kendoGrid({
                    dataSource: {
                        transport: {
                            read: {
                                url: "/Admin/GetAttendance",
                                dataType: "json",
                                data: {
                                    date: selectedDate ? kendo.toString(selectedDate, "yyyy-MM-dd") : null
                                }
                            }
                        },
                        pageSize: 10,
                        requestEnd: function () {
                            $(".loading-overlay").remove();
                        }
                    },
                    columnMenu: {
                        filterable: false,
                        columns: false
                    },
                    height: 550,
                    sortable: true,
                    filterable: true,
                    groupable: true,
                    pdf: {
                        allPages: true,
                        fileName: "Attendance_Summary_" + kendo.toString(new Date(), "yyyyMMdd") + ".pdf",
                        proxyURL: "https://demos.telerik.com/kendo-ui/service/export"
                    },
                    pageable: {
                        refresh: true,
                        pageSizes: [5, 10, 20, 50],
                        buttonCount: 5,
                        messages: {
                            display: "Showing {0}-{1} of {2} records",
                            itemsPerPage: "items per page"
                        }
                    },
                    columns: [
                        {
                            field: "empName",
                            title: "Employee Name",
                            width: "180px",
                            filterable: {
                                multi: true,
                                search: true
                            }
                        },
                        {
                            field: "attendDate",
                            title: "Date",
                            width: "130px",
                            template: "#= kendo.toString(kendo.parseDate(attendDate), 'dd-MMM-yyyy') #",
                            filterable: {
                                ui: "datetimepicker"
                            }
                        },
                        {
                            field: "clockInHour",
                            title: "Clock In",
                            width: "120px",
                            template: "#= clockInHour + ':' + (clockInMin < 10 ? '0' + clockInMin : clockInMin) #"
                        },
                        {
                            field: "clockOutHour",
                            title: "Clock Out",
                            width: "120px",
                            template: "#= clockOutHour + ':' + (clockOutMin < 10 ? '0' + clockOutMin : clockOutMin) #"
                        },
                        {
                            field: "workType",
                            title: "Work Type",
                            width: "120px",
                            filterable: {
                                multi: true,
                                search: true
                            }
                        },
                        {
                            field: "taskType",
                            title: "Task Type",
                            width: "150px",
                            filterable: {
                                multi: true,
                                search: true
                            }
                        },
                        {
                            field: "workingHour",
                            title: "Working Hours",
                            width: "130px"
                        },
                        {
                            field: "attendStatus",
                            title: "Attendance",
                            width: "130px",
                            template: function (dataItem) {
                                let badgeClass = "status-present";
                                let label = dataItem.attendStatus;

                                switch (dataItem.attendStatus) {
                                    case "Present":
                                        badgeClass = "status-present";
                                        break;
                                    case "Absent":
                                        badgeClass = "status-early";
                                        break;
                                    case "Half Day":
                                        badgeClass = "status-late";
                                        break;
                                    case "Leave":
                                        badgeClass = "status-late";
                                        break;
                                    default:
                                        badgeClass = "status-present";
                                }

                                return `<span class="status-badge ${badgeClass}">${label}</span>`;
                            },
                            filterable: {
                                multi: true,
                                search: true
                            }
                        }

                    ],
                    dataBound: function () {
                        this.tbody.find("tr").css("opacity", "0").animate({ opacity: 1 }, 500);
                    }
                });
            }

            function exportAllToPdf() {
                var selectedDate = $("#dateFilter").data("kendoDatePicker").value();

                // Show loading
                $(".grid-container").append(
                    '<div class="loading-overlay"><div class="spinner"></div></div>'
                );

                $.ajax({
                    url: "/Admin/GetAttendance",
                    data: {
                        date: selectedDate ? kendo.toString(selectedDate, "yyyy-MM-dd") : null,
                        allRecords: true 
                    },
                    type: "GET",
                    dataType: "json",
                    success: function (data) {
                        $(".loading-overlay").remove();

                        if (data && data.length > 0) {
                            createExportGrid(data);
                        } else {
                            alert("No data available to export.");
                        }
                    },
                    error: function () {
                        $(".loading-overlay").remove();
                        alert("Error loading data for export.");
                    }
                });
            }

            function createExportGrid(data) {
                var exportContainer = $("<div>").css({
                    position: "absolute",
                    left: "-9999px",
                    top: 0
                }).appendTo("body");

                var exportGrid = $("<div>").appendTo(exportContainer);

                exportGrid.kendoGrid({
                    dataSource: {
                        data: data,
                        pageSize: data.length
                    },
                    pdf: {
                        allPages: true,
                        fileName: "All_Attendance_Records_" + kendo.toString(new Date(), "yyyyMMdd") + ".pdf",
                        proxyURL: "https://demos.telerik.com/kendo-ui/service/export",
                        paperSize: "A4",
                        landscape: true,
                        margin: {
                            top: "2cm",
                            left: "1cm",
                            right: "1cm",
                            bottom: "2cm"
                        },
                        template: $("#page-template").html(),
                        repeatHeaders: true,
                        scale: 0.8
                    },
                    columns: [
                        { field: "empName", title: "Employee Name", width: 150 },
                        {
                            field: "attendDate",
                            title: "Date",
                            width: 100,
                            template: "#= kendo.toString(kendo.parseDate(attendDate), 'dd-MMM-yyyy') #"
                        },
                        {
                            field: "clockInHour",
                            title: "Clock In",
                            width: 80,
                            template: "#= clockInHour + ':' + (clockInMin < 10 ? '0' + clockInMin : clockInMin) #"
                        },
                        {
                            field: "clockOutHour",
                            title: "Clock Out",
                            width: 80,
                            template: "#= clockOutHour + ':' + (clockOutMin < 10 ? '0' + clockOutMin : clockOutMin) #"
                        },
                        { field: "workType", title: "Work Type", width: 100 },
                        { field: "taskType", title: "Task Type", width: 120 },
                        { field: "workingHour", title: "Working Hours", width: 100 },
                        {
                            field: "attendStatus",
                            title: "Status",
                            width: 100,
                            template: function (dataItem) {
                                return dataItem.attendStatus;
                            }
                        }
                    ]
                });

                exportGrid.data("kendoGrid").saveAsPDF();

                setTimeout(function () {
                    exportContainer.remove();
                }, 1000);
            }

            loadGrid();
        });
    </script>

    <script type="x/kendo-template" id="page-template">
            <div class="page-template">
                <div class="pdf-header">
                    <h2>Attendance Summary Report</h2>
                    <p>Generated on: #= kendo.toString(new Date(), "dd-MMM-yyyy HH:mm") #</p>
                </div>
                <div class="pdf-footer">
                    <p>Page #: pageNum # of #: totalPages #</p>
                </div>
            </div>
        </script>
}