@{
    ViewData["Title"] = "Employee Attendance";
    Layout = "../Shared/_EmployeeLayout.cshtml";
    var empId = (int)(ViewBag.EmpId ?? 1);
}

@* <!-- jQuery (must come first) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Kendo CSS & JS -->
<link href="@Url.Content("~/lib/kendo/kendo.default-v2.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/lib/kendo/kendo.all.min.js")"></script> *@


<style>
    :root {
        --primary-color: #ff9500;
        --primary-gradient: linear-gradient(135deg, #ff9500 0%, #ff6b35 100%);
        --secondary-color: #6c757d;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --light-color: #f8f9fa;
        --dark-color: #343a40;
        --border-radius: 12px;
        --box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        --transition: all 0.3s ease;
    }

    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ed 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
    }

    .attendance-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Employee Card */
    .employee-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        padding: 25px;
        margin-bottom: 25px;
        border: none;
        transition: var(--transition);
    }

    .employee-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
    }

    .employee-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .employee-name {
        font-size: 1.8rem;
        font-weight: 600;
        margin: 0;
        color: var(--dark-color);
    }

    .employee-email {
        color: var(--secondary-color);
        font-size: 1rem;
        margin: 5px 0;
    }

    .employee-status {
        display: inline-block;
        padding: 6px 15px;
        border-radius: 20px;
        font-weight: 500;
        font-size: 0.85rem;
    }

    .status-active {
        background: rgba(40, 167, 69, 0.15);
        color: var(--success-color);
    }

    .status-inactive {
        background: rgba(220, 53, 69, 0.15);
        color: var(--danger-color);
    }

    .employee-role {
        font-weight: 500;
        color: var(--primary-color);
        margin-top: 8px;
    }

    /* Action Buttons */
    .actions-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .action-btn {
        padding: 14px 30px;
        border-radius: var(--border-radius);
        font-weight: 600;
        font-size: 1.1rem;
        border: none;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 160px;
        justify-content: center;
    }

    .checkin-btn {
        background: var(--primary-gradient);
        color: white;
    }

    .checkin-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 7px 15px rgba(255, 149, 0, 0.4);
    }

    .checkout-btn {
        background: #f8f9fa;
        color: var(--dark-color);
        border: 2px solid #e0e0e0;
    }

    .checkout-btn:hover {
        background: #e9ecef;
        transform: translateY(-3px);
    }

    /* Work Mode Section */
    .work-mode-container {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        padding: 25px;
        margin-bottom: 25px;
        display: none;
    }

    .section-title {
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 15px;
        color: var(--dark-color);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title i {
        color: var(--primary-color);
    }

    /* Custom Kendo Styling */
    .k-dropdown .k-dropdown-wrap {
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 12px 16px;
        transition: var(--transition);
    }

    .k-dropdown .k-dropdown-wrap:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(255, 149, 0, 0.1);
    }

    .task-types-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 15px;
    }

    .task-checkbox {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 15px;
        background: #f8f9fa;
        border-radius: 8px;
        transition: var(--transition);
        cursor: pointer;
    }

    .task-checkbox:hover {
        background: #e9ecef;
    }

    .task-checkbox input {
        margin: 0;
    }

    /* Status Display */
    .status-container {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        padding: 20px;
        margin-bottom: 25px;
        text-align: center;
        min-height: 28px;
    }

    .status-message {
        font-weight: 600;
        font-size: 1.1rem;
    }

    .status-checked-in {
        color: var(--success-color);
    }

    .status-checked-out {
        color: #0d6efd;
    }

    .status-completed {
        color: var(--secondary-color);
    }

    /* Grid Styling */
    .grid-container {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        padding: 25px;
        overflow: hidden;
    }

    .grid-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .grid-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--dark-color);
        margin: 0;
    }

    .k-grid {
        border: none;
        border-radius: 10px;
        overflow: hidden;
    }

    .k-grid-header {
        background: var(--primary-gradient);
        color: white;
    }

    .k-grid-header .k-header {
        background: transparent;
        color: white;
        border-color: rgba(255,255,255,0.2);
        font-weight: 500;
    }

    .k-grid-content {
        border: 1px solid #e0e0e0;
        border-top: none;
    }

    .k-grid td {
        border-color: #f0f0f0;
    }

    .k-grid tr:hover {
        background-color: rgba(255, 149, 0, 0.05);
    }

    .task-box {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .save-tasks {
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: 6px;
        padding: 6px 12px;
        font-size: 0.85rem;
        transition: var(--transition);
    }

    .save-tasks:hover:not(.k-disabled) {
        background: #e08600;
        transform: translateY(-2px);
    }

    .save-tasks.k-disabled {
        background: #ccc;
        cursor: not-allowed;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .actions-container {
            flex-direction: column;
            align-items: center;
        }

        .action-btn {
            width: 100%;
            max-width: 300px;
        }

        .employee-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .employee-details {
            text-align: left;
        }

        .task-types-container {
            flex-direction: column;
            gap: 10px;
        }
    }
</style>

<div class="attendance-container">
    <!-- Employee Card -->
    <div class="employee-card">
        <div class="employee-header">
            <div class="employee-details">
                <h2 class="employee-name" id="empName">Employee</h2>
                <div class="employee-email" id="empEmail"></div>
            </div>
            <div class="employee-info">
                <div id="empStatus" class="employee-status status-active">Active</div>
                <div class="employee-role" id="empRole"></div>
                <div class="mt-2"><small>ID: <span id="empIdSpan">@empId</span></small></div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="actions-container">
        <button id="btnCheckIn" class="action-btn checkin-btn">
            <i class="fas fa-sign-in-alt"></i> Check In
        </button>
        <button id="btnCheckOut" class="action-btn checkout-btn">
            <i class="fas fa-sign-out-alt"></i> Check Out
        </button>
    </div>

    <!-- Work Mode (hidden until Check In) -->
    <div id="workModeWrap" class="work-mode-container">
        <div class="section-title">
            <i class="fas fa-laptop-house"></i> Work Mode
        </div>
        <input id="workMode" style="width:100%;" />
        
        <div class="section-title mt-4">
            <i class="fas fa-tasks"></i> Task Type (for this check-in)
        </div>
        <div class="task-types-container" id="tasks">
            <label class="task-checkbox">
                <input type="checkbox" name="taskTypes" value="Developing"> Developing
            </label>
            <label class="task-checkbox">
                <input type="checkbox" name="taskTypes" value="Designing"> Designing
            </label>
            <label class="task-checkbox">
                <input type="checkbox" name="taskTypes" value="Research"> Research
            </label>
        </div>
    </div>

    <!-- Status -->
    <div id="status" class="status-container"></div>

    <!-- Grid -->
    <div class="grid-container">
        <div class="grid-header">
            <h3 class="grid-title">Attendance History</h3>
        </div>
        <div id="grid"></div>
    </div>
</div>

<!-- Anti-forgery -->
<form id="af" method="post">@Html.AntiForgeryToken()</form>

@section Scripts {
<!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const EMP_ID = @empId;

    // Helpers
    function token(){ return $("#af input[name='__RequestVerificationToken']").val(); }
    function pickTasksHeader(){
        const arr=[]; $("input[name='taskTypes']:checked").each(function(){ arr.push($(this).val()); }); 
        return arr;
    }
    function todayStr(){
        const d = new Date();
        const mm = String(d.getMonth()+1).padStart(2,'0');
        const dd = String(d.getDate()).padStart(2,'0');
        return `${d.getFullYear()}-${mm}-${dd}`;
    }

    // Employee card
    $.getJSON("@Url.Action("GetEmployee","EmployeeView")", { empId: EMP_ID }, function(e){
        $("#empName").text(e.name ?? "Employee");
        $("#empEmail").text(e.email ?? "");
        $("#empStatus").text(e.status ?? "Inactive")
            .removeClass("status-active status-inactive")
            .addClass(e.status === "Active" ? "status-active" : "status-inactive");
        $("#empRole").text(e.role ?? "");
    });

    // Buttons as Kendo Buttons
    const btnIn  = $("#btnCheckIn").kendoButton({ themeColor: "primary" }).data("kendoButton");
    const btnOut = $("#btnCheckOut").kendoButton({ themeColor: "base" }).data("kendoButton");
    btnOut.enable(false);

    // Show Work Mode on Check In
    $("#btnCheckIn").on("click", function(){
        $("#workModeWrap").show();
        setTimeout(() => ddl.open(), 0);
    });

    // Work Mode DropDownList
    let postingCheckIn = false;
    const ddl = $("#workMode").kendoDropDownList({
        optionLabel: "Select work mode...",
        dataTextField: "text",
        dataValueField: "value",
        dataSource: [
            { text:"Remote Work", value:"Remote" },
            { text:"Office Work", value:"Office" },
            { text:"Field Work",  value:"Field"  }
        ],
        change: function () {
            const mode = this.value(), text = this.text();
            if (!mode || postingCheckIn) return;

            postingCheckIn = true; this.enable(false); btnIn.enable(false);

            $.ajax({
                type: "POST",
                url: "@Url.Action("CheckIn","EmployeeView")",
                data: {
                    __RequestVerificationToken: token(),
                    empId: EMP_ID,
                    workMode: mode,
                    taskTypes: pickTasksHeader()
                }
            }).done(function(res){
                if(res?.ok){
                    $("#status").html(`<div class="status-message status-checked-in">
                        <i class="fas fa-check-circle"></i> Checked In (${text}) at ${kendo.toString(new Date(),"HH:mm:ss")}
                    </div>`);
                    btnOut.enable(true);
                    btnIn.enable(false);
                    $("#workModeWrap").hide();
                    $("#grid").data("kendoGrid")?.dataSource.read().then(checkTodayStatus);
                } else {
                    kendo.alert(res?.message || "You have already checked in today. Please check in tomorrow.");
                    btnIn.enable(true);
                    $("#workModeWrap").hide();
                    ddl.value("");
                }
            }).fail(function(){
                alert("Server error.");
                btnIn.enable(true);
            }).always(() => {
                postingCheckIn = false;
                ddl.enable(true);
            });
        }
    }).data("kendoDropDownList");

    // Check Out
    $("#btnCheckOut").on("click", function () {
        $.ajax({
            type:"POST",
            url: "@Url.Action("CheckOut","EmployeeView")",
            data:{ __RequestVerificationToken: token(), empId: EMP_ID }
        }).done(function(res){
            if(res?.ok){
                $("#status").html(`<div class="status-message status-checked-out">
                    <i class="fas fa-door-open"></i> Checked Out at ${kendo.toString(new Date(),"HH:mm:ss")}
                    — Worked ${res.workedHours ?? 0}h • Status: ${res.status}
                </div>`);
                btnOut.enable(false); btnIn.enable(true);
                $("#grid").data("kendoGrid")?.dataSource.read().then(checkTodayStatus);
            } else {
                kendo.alert(res?.message || "Check-out failed.");
            }
        }).fail(() => alert("Server error."));
    });

    // Grid
    const grid = $("#grid").kendoGrid({
        dataSource: {
            transport: {
                read: {
                    url: "@Url.Action("AttendanceList","EmployeeView")",
                    data: { empId: EMP_ID },
                    dataType: "json"
                }
            },
            pageSize: 10,
            schema: {
                model: {
                    fields: {
                        c_attenddate: { type: "string" },
                        clockin: { type: "string" },
                        clockout: { type: "string" },
                        c_worktype: { type: "string" },
                        c_workinghour: { type: "number" },
                        c_attendstatus: { type: "string" },
                        c_tasktype: { type: "string" }
                    }
                }
            }
        },
        height: 420,
        sortable: true,
        pageable: {
            buttonCount: 5,
            pageSizes: [5, 10, 20],
            messages: {
                display: "Showing {0}-{1} from {2} records"
            }
        },
        columns: [
            { field:"c_attenddate", title:"Date", width:110 },
            { field:"clockin", title:"Clock In", width:90 },
            { field:"clockout", title:"Clock Out", width:90 },
            { field:"c_worktype", title:"Work Type", width:100 },
            { field:"c_workinghour", title:"Worked (h)", width:100, attributes: { "class": "text-right" } },
            { field:"c_attendstatus", title:"Status", width:100,
              template: function(data) {
                  let statusClass = "status-completed";
                  if (data.c_attendstatus === "Present") statusClass = "status-checked-in";
                  if (data.c_attendstatus === "Late") statusClass = "status-checked-out";
                  return `<span class="${statusClass}">${data.c_attendstatus}</span>`;
              }
            },
            { title:"Tasks", width:300, template: taskTemplate },
            { title:"Actions", width:110, template: saveBtnTemplate }
        ],
        dataBound: function(){
            lockTaskEditing.call(this);
            checkTodayStatus();
        }
    }).data("kendoGrid");

    function taskTemplate(data){
        const csv = (data.c_tasktype || "").split(",").map(x => x.trim()).filter(x => x.length);
        const c = t => csv.includes(t) ? "checked" : "";
        return `
          <div class="task-box">
            <label class="task-checkbox"><input type="checkbox" class="row-task" value="Developing" ${c("Developing")}> Developing</label>
            <label class="task-checkbox"><input type="checkbox" class="row-task" value="Designing" ${c("Designing")}> Designing</label>
            <label class="task-checkbox"><input type="checkbox" class="row-task" value="Research" ${c("Research")}> Research</label>
          </div>
        `;
    }

    function saveBtnTemplate(data){
        return `<button class="save-tasks" data-id="${data.c_attendid}">
                <i class="fas fa-save"></i> Save
            </button>`;
    }

    function lockTaskEditing(){
        const t = todayStr();
        const view = this.dataSource.view();
        const $rows = this.tbody.find("tr");

        $rows.each(function(i){
            const data = view[i];
            const isToday = data.c_attenddate === t;
            const hasClockOut = !!data.clockout;
            const editable = isToday && hasClockOut;

            $(this).find(".row-task").prop("disabled", !editable);
            const $btn = $(this).find(".save-tasks");
            $btn.prop("disabled", !editable).toggleClass("k-disabled", !editable);
        });
    }

    // Save tasks
    $("#grid").on("click", ".save-tasks", function(){
        const attendId = Number($(this).data("id"));
        const row = $(this).closest("tr");
        const tasks = [];
        row.find(".row-task:checked").each(function(){ tasks.push($(this).val()); });

        $.ajax({
            type: "POST",
            url: "@Url.Action("UpdateTasks","EmployeeView")",
            data: {
                __RequestVerificationToken: token(),
                attendId: attendId,
                taskTypes: tasks
            }
        }).done(function(res){
            if(res?.ok){
                kendo.alert("Tasks updated successfully!");
                $("#grid").data("kendoGrid")?.dataSource.read().then(checkTodayStatus);
            } else {
                const msg = res?.error || ("Update failed (rows: " + (res?.rowsAffected ?? 0) + ")");
                kendo.alert(msg);
            }
        }).fail(() => kendo.alert("Server error."));
    });

    // Check today's attendance and update buttons
    function checkTodayStatus(){
        return $.ajax({
            url: "@Url.Action("AttendanceList","EmployeeView")",
            data: { empId: EMP_ID },
            dataType: "json"
        }).done(function(rows){
            const t = todayStr();
            const todayRow = (rows || []).find(r => r.c_attenddate === t);
            if (!todayRow) {
                btnIn.enable(true);
                btnOut.enable(false);
                $("#status").empty();
                return;
            }

            const hasIn = !!todayRow.clockin && todayRow.clockin.trim() !== "";
            const hasOut = !!todayRow.clockout && todayRow.clockout.trim() !== "";

            if (hasIn && !hasOut) {
                btnIn.enable(false);
                btnOut.enable(true);
                $("#status").html(`<div class="status-message status-checked-in">
                    <i class="fas fa-check-circle"></i> Checked In at ${todayRow.clockin || "—"}
                </div>`);
            } else if (hasIn && hasOut) {
                btnIn.enable(true);
                btnOut.enable(false);
                $("#status").html(`<div class="status-message status-completed">
                    <i class="fas fa-clipboard-check"></i> Completed today (In: ${todayRow.clockin} • Out: ${todayRow.clockout})
                </div>`);
            } else {
                btnIn.enable(true);
                btnOut.enable(false);
                $("#status").empty();
            }
        }).fail(() => {
            btnIn.enable(true);
            btnOut.enable(false);
        });
    }

    // Initial check
    $(function(){ checkTodayStatus(); });
</script>
}